{
  "name": "gorka-portfolio-astro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm tokens:build && astro build",
    "preview": "astro preview",
    "proof": "node scripts/proof.mjs",
    "baseline": "node scripts/baseline.mjs",
    "parity": "node scripts/parity.mjs",
    "tokens:build": "tz build",
    "tokens:check": "tz check",
    "storybook": "pnpm tokens:build && PORTFOLIO_STORYBOOK=1 storybook dev -p 6006 --no-open",
    "build-storybook": "pnpm tokens:build && PORTFOLIO_STORYBOOK=1 storybook build -o storybook-static",
    "test:components": "playwright test",
    "test:components:update": "playwright test --update-snapshots",
    "design:lint": "node scripts/design-tokens.mjs --check && designmd lint DESIGN.md",
    "design:sync": "node scripts/design-tokens.mjs"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "1.64.0",
    "@storybook-astro/framework": "1.12.0",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/builder-vite": "10.6.2",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@terrazzo/cli": "2.7.1",
    "@terrazzo/plugin-css": "2.7.1",
    "@terrazzo/plugin-tailwind": "2.7.1",
    "cheerio": "1.2.0",
    "colorjs.io": "0.7.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "pngjs": "7.0.0",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3"
  }
}
