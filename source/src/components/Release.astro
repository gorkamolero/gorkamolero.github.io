---
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'article'>;
const { class: className = 'release', ...attributes } = Astro.props;
---
<article class={className} {...attributes}><slot /></article>

<style is:global>
@reference "../styles/global.css";
@layer components {
:where(body[data-page="music"]) .release {
        @apply grid; grid-template-columns: var(--dimension-11-5-rem) minmax(0, 1fr); gap: var(--dimension-1-6-rem); @apply items-center;
        padding: var(--dimension-1-5-rem) 0;
      }
:where(body[data-page="music"]) .release + .release { border-top: var(--dimension-1-px) solid var(--color-surface-16); }
:where(body[data-page="music"]) .release.tall { align-items: start; }
:where(body[data-page="music"]) .release h3 { font-family: var(--display); font-weight: var(--number-font-weight-400); font-size: var(--dimension-1-45-rem); letter-spacing: calc(var(--relative-0-07-em) * 1em); line-height: var(--number-line-height-1-15); margin: 0; }
:where(body[data-page="music"]) .release .meta { margin-top: var(--dimension-0-35-rem); font-size: var(--dimension-0-88-rem); }
:where(body[data-page="music"]) .release .player { margin-top: 0; }
@media (max-width: 640px) {
        :where(body[data-page="music"]) .release { grid-template-columns: 1fr; gap: var(--dimension-0-9-rem); padding: var(--dimension-1-3-rem) 0; }
}
}
</style>
