---
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'a'> & { variant?: 'plain' | 'primary' };
const { variant = 'plain', class: className = variant === 'primary' ? 'button primary' : 'button', href, target, rel, ...attributes } = Astro.props;
const external = typeof href === 'string' && /^https?:/.test(href);
---
<a class={className} href={href} target={external ? "_blank" : target} rel={external ? "noopener" : rel} {...attributes}><slot /></a>

<style is:global>
@reference "../styles/global.css";
@layer components {
.button { @apply inline-flex; @apply items-baseline; gap: calc(var(--relative-0-4-em) * 1em); padding: 0; border: 0; background: none; font-family: var(--display); font-size: var(--dimension-0-98-rem); letter-spacing: calc(var(--relative-0-05-em) * 1em); color: var(--ink); text-decoration: none; transition: color var(--motion-transition-200) ease; }
.button::after { content: "\2192"; color: var(--vermilion); transition: transform var(--motion-transition-250) ease; }
.button[target="_blank"]::after { content: "\2197"; }
.button:hover { color: var(--vermilion); }
.button:hover::after { transform: translateX(calc(var(--relative-0-18-em) * 1em)); }
.button[target="_blank"]:hover::after { transform: translate(calc(var(--relative-0-12-em) * 1em), calc(var(--relative-negative-0-12-em) * 1em)); }
.button.primary { background: linear-gradient(90deg, var(--color-gradient-start), var(--color-gradient-middle) calc(var(--relative-50-percent) * 1%), var(--color-gradient-end)); -webkit-background-clip: text; background-clip: text; color: transparent; }
.button.primary::before { content: ""; width: calc(var(--dots-leading) * 1em); height: calc(var(--dots-leading) * 1em); margin-right: calc(var(--relative-0-1-em) * 1em); border-radius: calc(var(--relative-50-percent) * 1%); background: var(--vermilion); align-self: baseline; @apply relative; top: calc(var(--relative-negative-0-12-em) * 1em); }
.button.primary::after { color: var(--color-gradient-end); }
.button.primary:hover { color: transparent; text-decoration: underline; text-decoration-color: var(--color-surface-8); text-underline-offset: calc(var(--relative-0-25-em) * 1em); }
@scope (html:has(body:not([data-page="index"], [data-page="creative"], [data-page="music"]))) {
.work a:not(.button):hover { color: var(--vermilion); }
}
}
</style>
