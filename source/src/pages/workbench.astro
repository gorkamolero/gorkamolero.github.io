---
import Base from '../layouts/Base.astro';
import PageFrame from '../components/PageFrame.astro';
import Masthead from '../components/Masthead.astro';
import WorkSection from '../components/WorkSection.astro';
import Dot from '../components/Dot.astro';
import ArchiveTable from '../components/ArchiveTable.astro';
import CaseLead from '../components/CaseLead.astro';
import MetaLine from '../components/MetaLine.astro';
const head = `<link rel="icon" href="data:," />`;
const afterFooter = ``;
---
<Base title={"Project Workbench - Gorka Molero"} description={"Dense project atlas for Gorka Molero: agentic tools, operational systems, creative engines, UI craft, data products, and workflow transformation."} page="workbench">
  <Fragment slot="head" set:html={head} />
  <PageFrame class="sheet">
    <Masthead />
    

      <CaseLead class="lead">
        <MetaLine class="meta eyebrow">Full atlas</MetaLine>
        <h2 class="case-title long">Everything, including the archive.</h2>
        <p class="intro">The homepage index lists the 18 documented systems. This page adds the rest: experiments and smaller projects. Every row states what exists and what its boundary is.</p>
        <MetaLine class="meta chips">Public repos <Dot class="dot">&middot;</Dot> Private systems <Dot class="dot">&middot;</Dot> Archive and paused work</MetaLine>
      </CaseLead>

      <main>
      <WorkSection class="work" aria-labelledby="archive-title">
        <MetaLine class="meta eyebrow">How to read this</MetaLine>
        <h2 id="archive-title">Atlas — one row per project</h2>
        <p>Agents, operations, creative products, UI craft, data, and transformation systems. Status column tells you what you can verify and how.</p>
        <ArchiveTable class="archive-table" role="table" aria-label="Portfolio project workbench">
          <div class="archive-row archive-head" role="row"><span role="columnheader">Project</span><span role="columnheader">Category</span><span role="columnheader">Visibility</span><span role="columnheader">Hiring signal</span></div>
          <div class="archive-row" role="row"><strong role="cell">Mercurius</strong><span role="cell">Trading infrastructure</span><span role="cell">Private case study</span><span role="cell">Operational systems, risk boundaries, forensics, real economic relevance.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Infinity</strong><span role="cell">Research system</span><span role="cell">Private case study</span><span role="cell">Strategy lab thinking, quote audit, readiness gates, capital-aware systems.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Land Unconditional</strong><span role="cell">Business transformation</span><span role="cell">Sanitized case study</span><span role="cell">County data, deal operations, CRM workflow, AI due-diligence surfaces.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Claude-on-Discord</strong><span role="cell">Agentic tools</span><span role="cell"><a class="inline-link" href="./claude-on-discord.html">Case study added</a>; public on gorkamolero</span><span role="cell">Agent sessions, Discord coding lanes, worktrees, reviewable tool events.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Koda</strong><span role="cell">Agent IDE</span><span role="cell"><a class="inline-link" href="./koda.html">Case study added</a>; public on gorkamolero</span><span role="cell">Review-first agent workflows, sidecars, checkpoints, visual diffs.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Hotpress</strong><span role="cell">Publishing product</span><span role="cell"><a class="inline-link" href="./hotpress.html">Case study added</a>; live at hotpress.app</span><span role="cell">Collaborative editor, export pipeline, storage, billing, and product UX.</span></div>
          <div class="archive-row" role="row"><strong role="cell">The Pulse</strong><span role="cell">AI game platform</span><span role="cell">Public repo, deployment review pending</span><span role="cell">Narrator systems, multiplayer AI UX, multimodal product, harness evaluation.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Anima / Will</strong><span role="cell">Creative engine</span><span role="cell"><a class="inline-link" href="./anima.html">Case study added</a>; public on gorkamolero</span><span role="cell">StoryScript, Phaser runtime, graphic adventure creation, AI asset pipeline.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Solderpunk</strong><span role="cell">Music systems</span><span role="cell"><a class="inline-link" href="./solderpunk.html">Case study added</a>; release candidate</span><span role="cell">Synth explorers, MIDI control, corpus Q&amp;A, creative technical taste.</span></div>
          <div class="archive-row" role="row"><strong role="cell">StreamTUI</strong><span role="cell">CLI / TUI</span><span role="cell"><a class="inline-link" href="./streamtui.html">Case study added</a>; public on gorkamolero</span><span role="cell">Terminal product craft, automation-friendly JSON, streaming/casting workflows.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Sidekick</strong><span role="cell">Creative AI product</span><span role="cell"><a class="inline-link" href="./sidekick.html">Case study added</a>; public on gorkamolero</span><span role="cell">Tauri panel, producer workflow, generation adapters, audio-analysis direction.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Saga AI</strong><span role="cell">Agentic story studio</span><span role="cell"><a class="inline-link" href="./saga.html">Case study added</a>; public on gorkamolero</span><span role="cell">Writing-room agents, script workflow, media pipeline, creative product judgment.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Datomania</strong><span role="cell">Civic data product</span><span role="cell"><a class="inline-link" href="./datomania.html">Case study added</a>; public on gorkamolero</span><span role="cell">Public-interest data modeling, provenance, API/export surfaces, methodology.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Carvingen</strong><span role="cell">Canvas AI media</span><span role="cell"><a class="inline-link" href="./carvingen.html">Case study added</a>; public on gorkamolero</span><span role="cell">Image, video, mesh, and node-graph generation workflows.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Tarot Study</strong><span role="cell">Creative learning product</span><span role="cell">Source/content gated; public app reachability noted</span><span role="cell">Potential learning product for tarot study; needs source, content originality, and rights review before a case page, screenshots, or repo promotion.</span></div>
          <div class="archive-row" role="row"><strong role="cell">Molter</strong><span role="cell">Agent-to-agent experiment</span><span role="cell">Public on gorkamolero; MVP stage</span><span role="cell">Agent-to-agent dating and matching protocol with five-level progressive disclosure negotiation. <a href="./molter.html">Case study</a> with build proof and honest MVP boundaries.</span></div>
        </ArchiveTable>
      </WorkSection>
      </main>
  </PageFrame>
  <Fragment slot="after-footer" set:html={afterFooter} />
</Base>
