---
import Base from '../layouts/Base.astro';
import PageFrame from '../components/PageFrame.astro';
import Masthead from '../components/Masthead.astro';
import WorkSection from '../components/WorkSection.astro';
import ActionRow from '../components/ActionRow.astro';
import TextLink from '../components/TextLink.astro';
import Dot from '../components/Dot.astro';
import Figure from '../components/Figure.astro';
import FactsList from '../components/FactsList.astro';
import CaseLead from '../components/CaseLead.astro';
import MetaLine from '../components/MetaLine.astro';
const head = `<link rel="icon" href="data:," />`;
const afterFooter = ``;
---
<Base title={"Before AI - Gorka Molero"} description={"Products Gorka Molero designed and built by hand before coding agents: Maility, Typeshare, the Chessable design system and earlier work."} page="pre-ai">
  <Fragment slot="head" set:html={head} />
  <PageFrame class="sheet">
    <Masthead />
    

      <CaseLead class="lead">
        <MetaLine class="meta eyebrow">2012&ndash;2023 &middot; Before coding agents</MetaLine>
        <h2 class="case-title">Before AI</h2>
        <p class="intro">Everything here was designed and built by hand, before coding agents existed. For the work I make with AI now, see the <a href="./creative.html">creative portfolio</a>.</p>
      </CaseLead>

      <main>
      <WorkSection class="work" id="maility">
        <h2>Maility</h2>
        <MetaLine class="meta">CTO and co-founder &middot; 2022&ndash;2023 <Dot class="dot">&middot;</Dot> React, Google Cloud, Nylas, Stripe</MetaLine>
        <p>A tool marketing agencies used to send cold email at scale. I built it on my own, from the product design and the React frontend to the sending infrastructure on Google Cloud with Nylas, Stripe billing and onboarding. Its shared inbox gave every agency client a separate workspace.</p>
        <p>It reached about $17K a month in revenue and grew to 150 users, each sending up to 1,000 emails a day.</p>
      </WorkSection>

      <WorkSection class="work" id="typeshare">
        <h2>Typeshare</h2>
        <MetaLine class="meta">Senior contract software engineer &middot; 2022&ndash;2023 <Dot class="dot">&middot;</Dot> Tiptap, ProseMirror, React, TypeScript</MetaLine>
        <p>I built the writing experience for a creator-writing product: the editor, the X thread editor and the Instagram carousel editor. I handled thread splitting, media formats, structured social blocks and editor performance, and worked on the move to Next.js.</p>
      </WorkSection>

      <WorkSection class="work" id="chessable">
        <h2>Chessable Edge</h2>
        <MetaLine class="meta">Frontend engineer &middot; 2020&ndash;2022 <Dot class="dot">&middot;</Dot> React, Clutch, Storybook, npm</MetaLine>
        <p>I led Chessable Edge, the design system that moved <a href="https://www.chessable.com" target="_blank" rel="noopener">Chessable</a>'s visual layer into one shared component library across product teams. We built it with Clutch, a visual builder for React, packaged it for npm, and three teams were using it in production. I also mentored a small team of junior engineers through component architecture, UI patterns, documentation and responsive behaviour in a difficult legacy codebase.</p>
        <Figure class="plate">
          <div class="shot"><video controls playsinline preload="none" poster="https://pub-066596d7e4fe4de2b74eac13bb03fe55.r2.dev/chessable-edge-poster.jpg" src="https://pub-066596d7e4fe4de2b74eac13bb03fe55.r2.dev/chessable-edge.mp4" aria-label="Chessable Edge, a guide for developers: what the design system is, how it is built with Clutch, and where it stood."></video></div>
          <figcaption>Chessable Edge, the guide for developers I made for the teams adopting it.</figcaption>
        </Figure>
      </WorkSection>

      <WorkSection class="work" id="earlier">
        <h2>Earlier</h2>
        <FactsList class="facts">
          <li><strong><a href="https://www.pickzen.com" target="_blank" rel="noopener">Pickzen</a></strong><span>Vue and React product-finder quizzes, embeddable widgets and merchant configuration for e-commerce. 2019&ndash;2023.</span></li>
          <li><strong><a href="https://adalab.es" target="_blank" rel="noopener">Adalab</a></strong><span>CTO of a coding school: React dashboards, Firebase Functions and no-code workflows for course tracking and for matching graduates with employers. 2019&ndash;2020.</span></li>
          <li><strong>BBVA Cells</strong><span>UI engineer on a PWA framework for mobile apps, shown at Google I/O 2016. 2015&ndash;2016.</span></li>
          <li><strong>William Hill</strong><span>Prototyped and built parts of the sportsbook redesign with the in-house designers. 2012&ndash;2014.</span></li>
          <li><strong>Writing</strong><span>"<a href="https://web.archive.org/web/20131010070722/http://speckyboy.com/2013/09/11/responsive-design-is-not-about-screen-sizes-any-more/" target="_blank" rel="noopener">Responsive Design is Not About Screen Sizes Any More</a>", featured by <a href="https://news.ycombinator.com/item?id=6366223" target="_blank" rel="noopener">Hacker News</a>, Awwwards, Codrops and Responsive Design Weekly, and "<a href="https://tympanus.net/codrops/2013/09/23/so-youre-a-web-designer-right/" target="_blank" rel="noopener">So, You&#39;re a Web Designer, right?</a>" for Codrops.</span></li>
        </FactsList>
        <ActionRow class="actions"><TextLink class="button primary" href="./creative.html">Creative work, with AI</TextLink>
          <TextLink class="button" href="./index.html">Engineering portfolio</TextLink></ActionRow>
      </WorkSection>
      </main>
  </PageFrame>
  <Fragment slot="after-footer" set:html={afterFooter} />
</Base>
