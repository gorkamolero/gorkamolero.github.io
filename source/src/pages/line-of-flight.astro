---
import Base from '../layouts/Base.astro';
import PageFrame from '../components/PageFrame.astro';
import Masthead from '../components/Masthead.astro';
import WorkSection from '../components/WorkSection.astro';
import Dot from '../components/Dot.astro';
import Figure from '../components/Figure.astro';
import FactsList from '../components/FactsList.astro';
import CaseLead from '../components/CaseLead.astro';
import MetaLine from '../components/MetaLine.astro';
// The Zencastr case study: unlisted (linked from the Zencastr CV), kept out of search engines.
const head = `<link rel="icon" href="data:," /><meta name="robots" content="noindex" /><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=GFS+Didot&family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&display=swap" />`;
const afterFooter = ``;
---
<Base title={"Line of Flight - Gorka Molero Case Study"} description={"Line of Flight, a video podcast recorded on Zencastr, and the studio and post-production tooling I built around it, from one start command to the edit."} page="line-of-flight">
  <Fragment slot="head" set:html={head} />
  <PageFrame class="sheet">
    <Masthead />

      <CaseLead class="lead">
        <MetaLine class="meta eyebrow">Case · podcast studio and post-production</MetaLine>
        <h2 class="case-title">Line of Flight</h2>
        <p class="intro">Line of Flight is a video podcast I make with a tantra teacher in Missouri. I bring a news story on slides, and my co-host, who hasn't seen it, reads it through the occult traditions as it lands. We record on Zencastr, and I built everything around it, from the studio to the edit.</p>
        <MetaLine class="meta chips">Own project <Dot class="dot">&middot;</Dot> 2026 <Dot class="dot">&middot;</Dot> Zencastr, Chrome DevTools Protocol, WebRTC, Python, ffmpeg, MediaPipe, Cloudflare</MetaLine>
      </CaseLead>

      <main>
      <WorkSection class="work">
        <h2>On air</h2>
        <p>Here's a minute and a quarter of episode 1, where I open the chapter on gold and my co-host cuts in.</p>
        <Figure class="plate">
          <div class="shot"><video controls playsinline preload="none" poster="./assets/line-of-flight/alchemy-and-gold-poster.webp" src="https://pub-066596d7e4fe4de2b74eac13bb03fe55.r2.dev/line-of-flight/alchemy-and-gold.mp4" aria-label="From episode 1 of Line of Flight: a chapter card reading Alchemy and Gold, then a 2008 paper on the history of potable gold, with both hosts in two circles on the slides while the co-host talks about science and the occult."></video></div>
          <figcaption>Recorded on 14 October 2026. The faces and the sound come from our Zencastr files, and my co-host's lip sync here measures 4 ms.</figcaption>
        </Figure>
      </WorkSection>

      <WorkSection class="work">
        <h2>The setup</h2>
        <p>My Mac runs the studio, and my co-host only opens a link. One command brings it all up, and one Record button starts the show's recording and Zencastr's together.</p>

        <figure class="plate lof-map" aria-label="How the studio is connected during the show, and what happens after it.">
          <div class="lof-flow">
            <p class="lof-flow-name">The call</p>
            <div class="lof-node"><span class="lof-where">Co-host's laptop</span><strong>Call tab</strong><span>Zencastr guest. Records his WAV and 1080p video.</span></div>
            <span class="lof-arrow" aria-hidden="true">&harr;</span>
            <div class="lof-node"><span class="lof-where">Zencastr</span><strong>The call</strong><span>Uploads each track as we talk.</span></div>
            <span class="lof-arrow" aria-hidden="true">&harr;</span>
            <div class="lof-node"><span class="lof-where">My Mac</span><strong>Room tab</strong><span>Records my WAV and video, driven by a watcher.</span></div>
          </div>
          <div class="lof-flow">
            <p class="lof-flow-name">The slides</p>
            <div class="lof-node"><span class="lof-where">Co-host's laptop</span><strong>Slides tab</strong><span>The deck, view only. Also records his mic.</span></div>
            <span class="lof-arrow" aria-hidden="true">&harr;</span>
            <div class="lof-node"><span class="lof-where">Cloudflare</span><strong>Tunnel and R2</strong><span>The slides through a tunnel, the media from R2.</span></div>
            <span class="lof-arrow" aria-hidden="true">&harr;</span>
            <div class="lof-node"><span class="lof-where">My Mac</span><strong>Deck server</strong><span>Slides follow my presenter.</span></div>
          </div>
          <div class="lof-flow">
            <p class="lof-flow-name">The Program</p>
            <div class="lof-node"><span class="lof-where">My Mac</span><strong>Camera sender</strong><span>My camera at 1920&times;1080 and my DJI mic.</span></div>
            <span class="lof-arrow" aria-hidden="true">&rarr;</span>
            <div class="lof-node"><span class="lof-where">My Mac</span><strong>The bridge</strong><span>My co-host's face and voice from the room tab.</span></div>
            <span class="lof-arrow" aria-hidden="true">&rarr;</span>
            <div class="lof-node"><span class="lof-where">My Mac</span><strong>The Program</strong><span>A hidden Chrome draws the show and records it in 4K.</span></div>
          </div>
          <div class="lof-flow">
            <p class="lof-flow-name">After the show</p>
            <div class="lof-node"><span class="lof-where">Zencastr</span><strong>Download</strong><span>The Library's zip, fetched until every track is in.</span></div>
            <span class="lof-arrow" aria-hidden="true">&rarr;</span>
            <div class="lof-node"><span class="lof-where">My Mac</span><strong>The cut</strong><span>Program parts lined up with Zencastr's cameras and voices.</span></div>
            <span class="lof-arrow" aria-hidden="true">&rarr;</span>
            <div class="lof-node"><span class="lof-where">My Mac</span><strong>The edit</strong><span>Cuts marked on the transcript, rendered in seconds.</span></div>
          </div>
        </figure>

        <h3>During the show</h3>
        <ol class="lof-steps">
          <li>One command brings the studio up. It sets my DJI mic over USB and opens Chrome with the Zencastr room, the presenter and the stage.</li>
          <li>The slides are a web app built from my script.</li>
          <li>The Program is the deck drawing the whole show, slides and both faces, recorded in a hidden Chrome at 3840&times;2160.</li>
          <li>Zencastr records each of us on our own machine and uploads as we go.</li>
          <li>A watcher drives the Zencastr tab over the DevTools Protocol and presses its buttons. It also bridges my co-host into the Program over WebRTC.</li>
          <li>My co-host gets one link, with the slides and a card that opens the Zencastr call.</li>
          <li>A cockpit in the presenter checks everything that can fail, and a red line blocks Start.</li>
        </ol>
        <h3>After the show</h3>
        <ol class="lof-steps" start="8">
          <li>Stop waits until my Zencastr tracks are fully uploaded, then closes everything.</li>
          <li>A downloader fetches the recording's zip from Zencastr until every track is in it.</li>
          <li>The cut lines up every Program part with Zencastr's tracks by sound and corrects each camera's lip sync. A 720p proxy for review takes about 12 minutes.</li>
          <li>I review the proxy and mark the cuts on the words of the transcript.</li>
          <li>The final cut renders in 4K, and the edit takes about 40 seconds for a 2 h 22 min episode.</li>
        </ol>
      </WorkSection>

      <WorkSection class="work">
        <h2>The deck</h2>
        <p>Every slide is HTML built from the script, in a paper look or a night look. These four from episode 1 are redrawn from the deck's layouts.</p>
        <figure class="plate lof">
          <div class="lof-deck" data-lof-deck data-look="paper" tabindex="0" role="region" aria-roledescription="slides" aria-label="Four slides from episode 1. Left and right arrow keys step through them.">
            <div class="lof-screen"><div class="lof-stage" aria-live="polite"></div></div>
            <div class="lof-bar">
              <button type="button" class="lof-btn" data-lof="prev" aria-label="Previous">&larr;</button>
              <span class="lof-count"><span data-lof="n">1</span> / 4 <span class="lof-name" data-lof="name"></span></span>
              <button type="button" class="lof-btn" data-lof="next" aria-label="Next">&rarr;</button>
              <span class="lof-looks" role="group" aria-label="Look"><button type="button" class="lof-look" data-look="paper" aria-pressed="true">Paper</button><button type="button" class="lof-look" data-look="night" aria-pressed="false">Night</button></span>
            </div>
          </div>
          <figcaption>Step through with the arrows, and drag the timeline. Ebers Papyrus and Geber from the Wellcome Collection (CC BY 4.0), Splendor Solis from the British Library (CC0), the rest public domain. The two engravings were generated after Henry de Malvost's 1895 plates.</figcaption>
        </figure>
      </WorkSection>

      <WorkSection class="work">
        <h2>The plate</h2>
        <p>Episode 2 is P(DOOM), and its master plate is one huge pen drawing of a Roman town on a quiet Sunday, in the manner of Bruegel. Everyone the episode talks about is in it, and the deck flies through it during the show.</p>
        <figure class="plate lof-pd" data-lof-plate>
          <div class="lof-pd-frame">
            <div class="lof-pd-view" tabindex="0" role="region" aria-roledescription="zoomable drawing" aria-label="The P(DOOM) plate. Left and right arrow keys step through its scenes.">
              <img class="lof-pd-still" src="./assets/line-of-flight/p-doom/plate.webp" width="1800" height="1200" loading="lazy" alt="The whole P(DOOM) plate: a Roman town seen from above under a stormy sky, with a forum in the middle, a tower of Babel on the left, temples and a domed church at the back, a market in front and a cave cut open under the street.">
              <p class="lof-pd-hint" data-pd="hint" aria-hidden="true">Drag to look around. Pinch or Ctrl-scroll to zoom. Press &rarr; for the next of its 20 scenes.</p>
            </div>
            <div class="lof-bar">
              <button type="button" class="lof-btn" data-pd="prev" aria-label="Previous scene">&larr;</button>
              <span class="lof-count"><span data-pd="n">1</span> / <span data-pd="total">20</span></span>
              <button type="button" class="lof-btn" data-pd="next" aria-label="Next scene">&rarr;</button>
              <span class="lof-looks"><button type="button" class="lof-look" data-pd="whole">Whole</button><button type="button" class="lof-look" data-pd="open" aria-pressed="false">Full screen</button></span>
            </div>
            <p class="lof-pd-say" aria-live="polite"><strong data-pd="name">The whole plate</strong> <span data-pd="text">The town from above, with a cave under its street and eight small scenes hidden in it.</span></p>
          </div>
          <figcaption>The full plate is 16,384 pixels wide.</figcaption>
        </figure>

        <h3>How it was made</h3>
        <FactsList class="facts">
          <li><strong>Square by square</strong><span>The empty town came first. An image model then drew townsfolk into it one grid square at a time, one generation for each of 34 squares.</span></li>
          <li><strong>Crowds on paper</strong><span>Crowds too big for a square, like the marches, were drawn twelve to a sheet and placed one figure at a time.</span></li>
          <li><strong>Foot checks</strong><span>Every figure has a picture of the ground under its feet, and the build won't run while any of them is out of date.</span></li>
          <li><strong>Faces</strong><span>Named figures were redrawn from photos. Grimes's pose only came right once it went to the model as a diagram.</span></li>
          <li><strong>Review</strong><span>An independent reviewer agent checked every close-up at full size and sent back whatever was wrong, over 30 passes, until nothing was left to fix.</span></li>
        </FactsList>
        <figure class="plate lof-pair">
          <div class="lof-pair-row">
            <div class="shot"><img src="./assets/line-of-flight/p-doom/grimes-pose.webp" width="1600" height="911" loading="lazy" alt="A pose diagram: on the left, a mannequin sitting at the foot of a round well beside a dark mound marked as the AI, her head the size of a standing priest's; on the right, the pose close up, labelled: head tilted and resting on the well, brass collar, right hand flat on the well's step, left hand on her knee, legs folded to her left under a long skirt."></div>
            <div class="shot"><img src="./assets/line-of-flight/p-doom/grimes-drawn.webp" width="899" height="840" loading="lazy" alt="The AI, a mass of black coiled tentacles studded with eyes and wearing a small smiling white mask, chained to a stone well and ringed by hooded priests; Grimes sits on the paving at the well's foot in a long dress, leaning on it, bored, with a chain from her brass collar up to a tentacle."></div>
          </div>
          <figcaption>The pose diagram given to the model, and Grimes on the plate.</figcaption>
        </figure>
      </WorkSection>

      <WorkSection class="work">
        <h2>The audio</h2>
        <p>I wear headphones and a clip-on DJI Mic Mini 2S, whose settings are written to the receiver over USB at every start. Clipped on, it gives about 14 dB more voice than the MacBook's mic. Zencastr is pinned to it with echo cancellation, noise suppression and auto gain off, so the voice reaches the WAV as the mic gives it.</p>
        <p>Every voice is recorded more than once. Zencastr's local WAVs are the masters, and the Program keeps a safety copy of each voice. My co-host's slides tab also records his mic as a backup.</p>
        <p>The cut places each ten-minute Program part on Zencastr's timeline by matching loudness, checked at three points to within 50 ms. A first version that guessed each part's length was 27 seconds off by part 9.</p>
        <p>The mix is the two clean voices, with the Program's sound let in only where a clip played. It's mastered to &minus;16 LUFS.</p>
      </WorkSection>

      <WorkSection class="work">
        <h2>Where Zencastr pushed back</h2>
        <p>Scripting a studio around Zencastr ran into these nine problems. Most of them turned up in a test rig, with a scripted stand-in co-host on my second laptop.</p>
        <FactsList class="facts">
          <li><strong>Stop ends the session</strong><span>Stop ends the recording, and pausing loses a guest who joins mid-pause. So Zencastr records the whole session, and the cut finds each take in it by sound.</span></li>
          <li><strong>A dead tab's stretch never finishes</strong><span>If the guest's call tab dies mid-recording, that stretch never reaches the download. One drop test lost 12 of his 15 tracks. His slides tab now records his mic as a backup, and it filled 9.3 minutes of episode 1.</span></li>
          <li><strong>Nothing stops the room closing mid-upload</strong><span>In a scripted studio nobody clicks Zencastr's "Leave site?" warning, so Stop waits for 100% upload before it closes anything.</span></li>
          <li><strong>Getting the files</strong><span>The room's download buttons did nothing for me, but the Library's zip works. The download keeps fetching it until every track is in.</span></li>
          <li><strong>The first camera request sets the size</strong><span>In one Chrome, the first page to open the camera sets its size for all of them, and Zencastr's green room took 640&times;360. The camera sender now opens it first at 1920&times;1080.</span></li>
          <li><strong>The guest at his tile's size</strong><span>Zencastr sends a guest at his tile's size, 640&times;360. The live show uses that small picture, and the cut uses his full-size local file.</span></li>
          <li><strong>A take cancelled five seconds in</strong><span>One failed upload request on the guest's side aborted a take for everyone. The watcher now presses Record again whenever Zencastr stops during a take.</span></li>
          <li><strong>Camera files drift</strong><span>After a reload 44 minutes into episode 1, my co-host's camera ran 0.11 to 0.14 s late. The cut measures lip sync every ten minutes with MediaPipe and fixes it to within a frame.</span></li>
          <li><strong>File names on a 12-hour clock</strong><span>Zencastr names its local files on a 12-hour UTC clock, so the tools take the folder written last.</span></li>
        </FactsList>
      </WorkSection>

      <WorkSection class="work">
        <h2>Numbers</h2>
        <FactsList class="facts">
          <li><strong>Built</strong><span>In three weeks, from 27 September to 15 October 2026.</span></li>
          <li><strong>Drops</strong><span>In six tests of the guest dropping out, the studio recovered by itself every time, in 17 to 103 seconds.</span></li>
          <li><strong>Zencastr</strong><span>45 recordings in one room between 5 and 14 October.</span></li>
          <li><strong>Episode 1</strong><span>A 154-minute session cut to 2 h 22 min.</span></li>
          <li><strong>Turnaround</strong><span>About ten minutes a file to download, 12 minutes for the review proxy and 40 seconds for the edit.</span></li>
          <li><strong>On disk</strong><span>235 GB of recordings.</span></li>
        </FactsList>
      </WorkSection>
      </main>
  </PageFrame>
  <Fragment slot="after-footer" set:html={afterFooter} />
</Base>

<style is:global>
/* the studio map: four flows, three nodes each, stacked on a phone */
.lof-map { margin: 1.6rem 0 0; }
.lof-flow { display: grid; grid-template-columns: 6.6rem 1fr 1.4rem 1fr 1.4rem 1fr; align-items: stretch; padding: 0.9rem 0; border-top: 1px solid var(--rule); }
.lof-flow:last-child { border-bottom: 1px solid var(--rule); }
.lof-flow-name { margin: 0; padding-top: 0.15rem; font-family: var(--display); font-size: 1rem; letter-spacing: 0.04em; color: var(--vermilion); }
.lof-node { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.55rem 0.7rem 0.6rem; border: 1px solid var(--rule); background: rgba(255, 252, 244, 0.45); font-size: 0.92rem; line-height: 1.3; }
.lof-node strong { font-weight: 600; font-size: 1rem; }
.lof-node span:last-child { color: var(--ink-soft); }
.lof-where { font-family: var(--display); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); }
.lof-arrow { align-self: center; text-align: center; color: var(--vermilion); font-size: 1.1rem; }
@media (max-width: 640px) {
  .lof-flow { grid-template-columns: 1fr; row-gap: 0.15rem; }
  .lof-flow-name { padding: 0 0 0.35rem; }
  .lof-arrow { transform: rotate(90deg); line-height: 1.3; }
}
.lof-steps { margin: 0 0 1rem; padding-left: 1.6rem; }
.lof-steps li { margin: 0 0 0.45rem; padding-left: 0.2rem; }
.lof-steps li::marker { font-family: var(--display); color: var(--vermilion); }

/* the deck sampler: a 1920x1080 stage scaled to the column, in the deck's two looks */
.lof .lof-deck { outline: none; }
.lof .lof-deck:focus-visible .lof-screen { box-shadow: 0 0 0 2px var(--vermilion); }
.lof-screen { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--rule); background: var(--ground); cursor: pointer; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
.lof-stage { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; background: var(--ground); color: var(--ink); overflow: hidden; font-family: var(--old); font-variant-numeric: normal; }
.lof-deck[data-look="paper"] .lof-screen { --ground: #fef8ea; --ink: #1b1714; --ink3: #8a8174; --red: #8f3622; --gray: #6b6258; --line: #1b1714; --wash: 254, 248, 234; }
.lof-deck[data-look="night"] .lof-screen { --ground: #000; --ink: #f1e9d6; --ink3: #7d766a; --red: #d2a64a; --gray: #a39b8c; --line: #3a342d; --wash: 0, 0, 0; }
.lof-deck { --didot: "Didot", "GFS Didot", "Bodoni 72", serif; --old: "Old Standard TT", "Old Standard", "EB Garamond", serif; }
.lof-stage .abs { position: absolute; }
.lof-stage img { -webkit-user-drag: none; pointer-events: none; }
.lof-stage .push { animation: lofPush 45s linear forwards; transform-origin: 50% 50%; }
.lof-stage.dip > * { animation: lofDip 0.7s ease-out both; }
@keyframes lofPush { from { transform: scale(1); } to { transform: scale(1.06); } }
@keyframes lofDip { from { opacity: 0; } to { opacity: 1; } }
.lof-stage .rules { position: absolute; height: 11px; box-sizing: border-box; border-top: 2px solid var(--ink); border-bottom: 5px solid var(--ink); }
.lof-stage .rules.under { border-top-width: 5px; border-bottom-width: 2px; }
.lof-stage .card-label { font-family: var(--old); text-transform: uppercase; letter-spacing: 0.24em; font-size: 20px; color: var(--gray); }
.lof-stage .card-title { font-family: var(--didot); text-transform: uppercase; letter-spacing: 0.15em; color: var(--ink); white-space: nowrap; }
.lof-stage .card-title .acc { color: var(--red); }
.lof-stage .card-sub { font-family: var(--old); text-transform: uppercase; letter-spacing: 0.2em; font-size: 22px; color: var(--red); white-space: nowrap; }
.lof-stage .quote-block { left: 260px; width: 1400px; top: 0; height: 1080px; display: flex; flex-direction: column; justify-content: center; align-items: center; }
.lof-stage .quote { margin-top: 50px; font-family: var(--old); font-style: italic; font-size: 48px; line-height: 1.4; text-align: center; color: var(--ink); }
.lof-stage .rule { width: 160px; height: 11px; margin: 44px 0 0; box-sizing: border-box; border-top: 2px solid var(--ink); border-bottom: 5px solid var(--ink); }
.lof-stage .attrib { margin-top: 22px; font-family: var(--old); text-transform: uppercase; letter-spacing: 0.2em; font-size: 22px; color: var(--red); }
.lof-stage .ornament { position: relative; width: 200px; height: 18px; }
.lof-stage .ornament::before, .lof-stage .ornament::after { content: ''; position: absolute; top: 8px; width: 78px; height: 2px; background: var(--red); }
.lof-stage .ornament::before { left: 0; }
.lof-stage .ornament::after { right: 0; }
.lof-stage .ornament i { position: absolute; left: 50%; top: 9px; width: 12px; height: 12px; margin: -6px 0 0 -6px; background: var(--red); transform: rotate(45deg); }
.lof-stage .ornament b, .lof-stage .ornament u { position: absolute; top: 7px; width: 4px; height: 4px; border-radius: 50%; background: var(--red); }
.lof-stage .ornament b { left: 82px; }
.lof-stage .ornament u { right: 82px; }
.lof-stage .tl { position: absolute; left: 0; top: 0; height: 1080px; transform-origin: 0 0; transition: transform 0.9s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform; }
.lof-stage .tl.live { transition: none; }
.lof-stage .tl-base { position: absolute; top: 498px; height: 1px; background: var(--ink); }
.lof-stage .tl-era { position: absolute; top: 7.7px; height: 6.7px; box-sizing: border-box; border-top: 1.25px solid var(--ink); border-bottom: 3px solid var(--ink); }
.lof-stage .tl-era span { position: absolute; left: 0; top: -24px; font-family: var(--old); text-transform: uppercase; letter-spacing: 0.2em; font-size: 14px; color: var(--red); white-space: nowrap; }
.lof-stage .tl-ev { position: absolute; top: 0; width: 640px; height: 1080px; }
.lof-stage .tl-ev .box { position: absolute; left: 40px; top: 44.7px; width: 560px; height: 380px; transform: scale(0.952); transform-origin: 50% 0; }
.lof-stage .tl-ev .box img { position: absolute; object-fit: cover; background: #000; outline: 1.27px solid var(--line); }
.lof-stage .tl-ev .box img.whole { object-fit: contain; outline: none; background: transparent; }
.lof-stage .tl-ev .box .li { position: absolute; left: -40px; width: 640px; text-align: center; white-space: nowrap; font-family: var(--old); color: var(--ink); }
.lof-stage .tl-ev .box .li.last { color: var(--red); }
.lof-stage .tl-ev .yr { position: absolute; left: 0; width: 640px; top: 434.4px; text-align: center; font-family: var(--didot); font-size: 40px; line-height: 46px; letter-spacing: 0.12em; color: var(--ink); }
.lof-stage .tl-ev .dot { position: absolute; left: 314px; top: 493px; width: 11px; height: 11px; border-radius: 50%; background: var(--red); }
.lof-stage .tl-ev .ti { position: absolute; left: -80px; width: 800px; top: 511px; text-align: center; font-family: var(--didot); text-transform: uppercase; letter-spacing: 0.3em; font-size: 15px; line-height: 24px; color: var(--ink); }
.lof-stage .tl-ev .su { position: absolute; left: -40px; width: 720px; top: 542.7px; text-align: center; font-family: var(--old); text-transform: uppercase; letter-spacing: 0.2em; font-size: 12.5px; line-height: 16px; color: var(--red); }
.lof-bar { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.55rem; font-family: var(--display); }
.lof-btn, .lof-look { font: inherit; color: var(--ink); background: transparent; border: 1px solid var(--rule); padding: 0.15rem 0.7rem; cursor: pointer; }
.lof-btn { font-size: 1.05rem; line-height: 1.4; }
.lof-btn:hover, .lof-look:hover { border-color: var(--vermilion); color: var(--vermilion); }
.lof-btn:disabled { opacity: 0.35; cursor: default; border-color: var(--rule); color: var(--ink); }
.lof-count { color: var(--ink-soft); font-size: 0.95rem; white-space: nowrap; }
.lof-name { margin-left: 0.4rem; color: var(--ink); }
.lof-looks { margin-left: auto; display: inline-flex; }
.lof-look { font-size: 0.9rem; }
.lof-look + .lof-look { border-left: 0; }
.lof-look[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper, #eee6d5); }
@media (max-width: 640px) {
  .lof-name { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .lof-stage .push, .lof-stage.dip > * { animation: none; }
  .lof-stage .tl { transition: none; }
}

/* the P(DOOM) plate: wider than the text column (up to 84rem, at most 86% of the screen's height), edge to edge on a phone, and it can take the whole window */
.lof-pd-frame { --w: min(calc(100vw - 2rem), 84rem); width: var(--w); margin-left: calc((100% - var(--w)) / 2); }
.lof-pd-view { position: relative; height: max(26rem, calc(100vh - 5.25rem)); height: max(26rem, calc(100svh - 5.25rem)); border: 1px solid var(--rule); background: #fef8ea; overflow: hidden; outline: none; }
.lof-pd-view:focus-visible { box-shadow: 0 0 0 2px var(--vermilion); }
.lof-pd-still { position: absolute; left: 0; top: 0; width: 100%; height: 100%; object-fit: cover; }
.lof-pd-hint { position: absolute; z-index: 3; left: 50%; bottom: 1rem; transform: translateX(-50%); width: max-content; max-width: calc(100% - 2rem); margin: 0; padding: 0.45rem 0.9rem; background: rgba(29, 26, 23, 0.84); color: #f1e9dc; font-size: 0.98rem; line-height: 1.35; text-align: center; pointer-events: none; transition: opacity 0.6s; }
.lof-pd.is-used .lof-pd-hint { opacity: 0; }
.lof-pd-say { margin: 0.6rem 0 0; min-height: 1.45em; font-size: 1rem; line-height: 1.45; color: var(--ink-soft); }
.lof-pd-say strong { margin-right: 0.3rem; font-family: var(--display); font-weight: 400; letter-spacing: 0.04em; color: var(--ink); }
.lof-pd.is-open .lof-pd-frame { position: fixed; inset: 0; z-index: 100; width: auto; margin: 0; display: flex; flex-direction: column; padding: 0.8rem 1rem 0.6rem; background: var(--paper, #eee6d5); }
.lof-pd.is-open .lof-pd-view { flex: 1; height: auto; }
html.lof-pd-lock { overflow: hidden; }
.lof-pair-row { display: grid; grid-template-columns: 1.756fr 1.07fr; gap: 0.8rem; align-items: start; }
.lof-pair-row .shot { margin: 0; }
@media (max-width: 640px) {
  .lof-pd-frame { --w: 100vw; }
  .lof-pd-view { height: max(24rem, calc(100vh - 7rem)); height: max(24rem, calc(100svh - 7rem)); border-left: 0; border-right: 0; }
  .lof-pd-frame > .lof-bar, .lof-pd-say { padding: 0 1rem; }
  .lof-pd.is-open .lof-pd-frame { padding: 0.6rem 0 0.5rem; }
  .lof-pd.is-open .lof-pd-view { height: auto; }
  .lof-pair-row { grid-template-columns: 1fr; }
}
</style>

<script>
const root = document.querySelector<HTMLElement>('[data-lof-deck]');
if (root) {
  const A = './assets/line-of-flight/deck/';
  const stage = root.querySelector<HTMLElement>('.lof-stage')!;
  const screen = root.querySelector<HTMLElement>('.lof-screen')!;
  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  type Card = { type: 'card'; name: string; image: string; alt: string; label?: string; title: string[]; accent?: string; sub: string[]; L: number; W: number; fs: number };
  type Quote = { type: 'quote'; name: string; quote: string; attrib: string };
  type Line = { type: 'timeline'; name: string };
  const SLIDES: (Card | Quote | Line)[] = [
    { type: 'card', name: 'The cold open', image: 'lake', alt: 'An engraving of a lake at night behind a villa with a gazebo, a swimmer in the water.', label: 'Case one', title: ['The man', 'who', 'injected', 'gold'], sub: ['Samut Prakan, Thailand', '7 July 2026'], L: 1280, W: 560, fs: 60 },
    { type: 'card', name: 'A chapter card', image: 'alchemy', alt: 'An engraving of an alchemist in his laboratory holding up a glowing flask.', title: ['Alchemy', 'and', 'gold'], accent: 'gold', sub: ['The quest for immortality'], L: 1250, W: 560, fs: 67 },
    { type: 'timeline', name: 'The timeline' },
    { type: 'quote', name: 'The paper’s last line', quote: 'The prolonged efforts throughout medical history to discover the therapeutic value of gold has included periods of great enthusiasm and complete rejection.', attrib: 'Stata Norton · 2008' },
  ];

  type Ev = { year: string; title: string; sub?: string; imgs?: string[]; list?: string[]; whole?: number[] };
  const EVENTS: Ev[] = [
    { year: '2900 BCE', title: 'Egypt', sub: 'Ebers Papyrus, c. 1500 BCE', imgs: ['egyptian-physician'] },
    { year: '210 BCE', title: 'Qin Shi Huang', imgs: ['qin-shi-huang'] },
    { year: '8th c.', title: 'Jabir ibn Hayyan', imgs: ['jabir-geber'] },
    { year: '1493 – 1541', title: 'Paracelsus', sub: 'Swiss physician and alchemist', imgs: ['splendor-solis-harley-f7-knight-fountains'] },
    { year: '1566', title: 'Diane de Poitiers', imgs: ['diane-de-poitiers-clouet-workshop-1555'] },
    { year: '1567', title: 'The Jiajing Emperor', imgs: ['ming-jiajing'] },
    { year: '1597', title: 'Shakespeare', imgs: ['shakespeare-chandos-portrait', 'shakespeare-2h4-first-folio-p1'] },
    { year: '1690s', title: 'Isaac Newton', imgs: ['newton-kneller-1689', 'newton-sophick-mercury-ms-p1', 'newton-alchemical-ms-aq17'] },
    { year: '1879', title: 'The gold cure', imgs: ['keeley-institute', 'keeley-institute-building-1894'], whole: [1.523, 1.07] },
    { year: '1890', title: 'Robert Koch', imgs: ['koch-portrait'] },
    { year: '1926', title: 'U.S. Pharmacopoeia', list: ['Dyspepsia', 'Cirrhosis', 'Syphilis', 'Tuberculosis', 'Depression', 'Hypochondria', 'Hysteria', 'And impotence'] },
  ];
  const ERAS = [{ name: 'Antiquity', fr: 0, to: 2 }, { name: 'The Renaissance', fr: 3, to: 6 }, { name: 'It becomes medicine', fr: 8, to: 10 }];
  const SP = 640, Z = 1.65, CY = 281, N = EVENTS.length;

  let i = 0, pos = 0, panX = 0, entered = false;
  let look = 'paper';
  try { const s = localStorage.getItem('lof-look'); if (s === 'night' || s === 'paper') look = s; } catch (_) {}

  const still = (name: string) => `${A}${name}-${look}.webp`;

  function card(sl: Card) {
    const lh = Math.round(sl.fs * 1.15), L = sl.L, W = sl.W;
    const bh = (sl.label ? 47 : 0) + 11 + 27 + sl.title.length * lh + 22 + 11 + (sl.sub.length ? 26 + sl.sub.length * 36 : 0);
    let y = Math.round(540 - bh / 2);
    let h = `<img class="abs push" src="${still(sl.image)}" alt="${esc(sl.alt)}" style="left:0;top:0;width:1920px;height:1080px;object-fit:cover">`;
    h += `<div class="abs" style="left:0;top:0;width:1920px;height:1080px;background:linear-gradient(90deg,rgba(var(--wash),0) ${L - 260}px,rgba(var(--wash),.82) ${L - 40}px,rgba(var(--wash),.88))"></div>`;
    h += `<div class="abs" style="left:${L - 220}px;width:${W + 440}px;top:${y - 170}px;height:${bh + 340}px;background:radial-gradient(closest-side,rgba(var(--wash),.97),rgba(var(--wash),.9) 60%,rgba(var(--wash),0))"></div>`;
    if (sl.label) { h += `<div class="abs card-label" style="left:${L}px;top:${y}px">${esc(sl.label)}</div>`; y += 47; }
    h += `<div class="rules" style="left:${L}px;width:${W}px;top:${y}px"></div>`; y += 38;
    for (const ln of sl.title) {
      const t = sl.accent && ln === sl.accent ? `<span class="acc">${esc(ln)}</span>` : esc(ln);
      h += `<div class="abs card-title" style="left:${L}px;top:${y}px;font-size:${sl.fs}px;line-height:${lh}px">${t}</div>`; y += lh;
    }
    y += 22; h += `<div class="rules under" style="left:${L}px;width:${W}px;top:${y}px"></div>`; y += 37;
    for (const su of sl.sub) { h += `<div class="abs card-sub" style="left:${L}px;top:${y}px">${esc(su)}</div>`; y += 36; }
    return h;
  }

  function quote(sl: Quote) {
    return `<div class="abs quote-block"><div class="ornament"><b></b><i></i><u></u></div><div class="quote">${esc(sl.quote)}</div><div class="rule"></div><div class="attrib">${esc(sl.attrib)}</div></div>`;
  }

  // an event's 560x380 box: one picture, two side by side, one large and two stacked, or a list of lines
  function box(ev: Ev) {
    const W = 560, H = 380, G = 8, r = (x: number, y: number, w: number, h: number) => `left:${Math.round(x)}px;top:${Math.round(y)}px;width:${Math.round(w)}px;height:${Math.round(h)}px`;
    if (ev.list) {
      const n = ev.list.length, lh = Math.min(44, 380 / n);
      return ev.list.map((t, k) => `<div class="li${k === n - 1 ? ' last' : ''}" style="top:${Math.round(190 - (n * lh) / 2 + k * lh)}px;line-height:${lh}px;font-size:${Math.min(32, Math.round(lh * 0.8))}px">${esc(t)}</div>`).join('');
    }
    const imgs = ev.imgs || [], n = imgs.length;
    let cells: string[] = [];
    if (n === 1) cells = [r(0, 0, W, H)];
    else if (n === 2 && ev.whole) {
      const tw = (ev.whole[0] + ev.whole[1]) * H, sc = Math.min(1, (W - G) / tw), h = H * sc, w0 = ev.whole[0] * h, w1 = ev.whole[1] * h, x0 = (W - (w0 + w1 + G)) / 2, y = (H - h) / 2;
      cells = [r(x0, y, w0, h), r(x0 + w0 + G, y, w1, h)];
    } else if (n === 2) { const w = (W - G) / 2; cells = [r(0, 0, w, H), r(w + G, 0, w, H)]; }
    else { const w = Math.round(W * 0.58), w2 = W - w - G, h = (H - G) / 2; cells = [r(0, 0, w, H), r(w + G, 0, w2, h), r(w + G, h + G, w2, h)]; }
    return imgs.map((src, k) => `<img src="${A}${src}.webp" alt="" loading="lazy" class="${ev.whole ? 'whole' : ''}" style="${cells[k]}">`).join('');
  }

  function timeline() {
    let h = `<div class="tl" style="width:${N * SP}px"><div class="tl-base" style="left:0;width:${N * SP}px"></div>`;
    for (const e of ERAS) h += `<div class="tl-era" style="left:${e.fr * SP + 40}px;width:${(e.to - e.fr + 1) * SP - 80}px"><span>${esc(e.name)}</span></div>`;
    EVENTS.forEach((ev, k) => {
      h += `<div class="tl-ev" style="left:${k * SP}px"><div class="box">${box(ev)}</div><div class="yr">${esc(ev.year)}</div><div class="dot"></div><div class="ti">${esc(ev.title)}</div>${ev.sub ? `<div class="su">${esc(ev.sub)}</div>` : ''}</div>`;
    });
    return h + '</div>';
  }

  function camera(instant = false) {
    const el = stage.querySelector<HTMLElement>('.tl'); if (!el) return;
    el.classList.toggle('live', instant);
    el.style.transform = `translate(${960 - (pos * SP + SP / 2) * Z + panX}px,${540 - CY * Z}px) scale(${Z})`;
  }

  const prevBtn = root.querySelector<HTMLButtonElement>('[data-lof="prev"]')!, nextBtn = root.querySelector<HTMLButtonElement>('[data-lof="next"]')!;
  function show(n: number, from = 0) {
    const was = i; i = Math.max(0, Math.min(SLIDES.length - 1, n)); const sl = SLIDES[i];
    stage.classList.remove('dip');
    stage.innerHTML = sl.type === 'card' ? card(sl) : sl.type === 'quote' ? quote(sl) : timeline();
    if (sl.type === 'card' && i !== was) { void stage.offsetWidth; stage.classList.add('dip'); }
    if (sl.type === 'timeline') {
      panX = 0; pos = from < 0 ? N - 1 : 0;
      const el = stage.querySelector<HTMLElement>('.tl')!;
      if (!entered) {   // the first visit: the whole line for a beat, then in
        entered = true; const sc = 1920 / (N * SP);
        el.classList.add('live'); el.style.transform = `translate(0px,${540 - CY * sc}px) scale(${sc})`;
        void el.offsetWidth; setTimeout(() => camera(), 650);
      } else camera(true);
    }
    root!.querySelector('[data-lof="n"]')!.textContent = String(i + 1);
    root!.querySelector('[data-lof="name"]')!.textContent = '· ' + sl.name;
    stage.setAttribute('aria-label', `Slide ${i + 1} of ${SLIDES.length}: ${sl.name}`);
    prevBtn.disabled = i === 0 && !(sl.type === 'timeline' && pos > 0);
    nextBtn.disabled = i === SLIDES.length - 1;
    const nx = SLIDES[i + 1]; if (nx && nx.type === 'card') new Image().src = still(nx.image);
  }

  function step(d: number) {
    const sl = SLIDES[i];
    if (sl.type === 'timeline') {
      const p = pos + d;
      if (p >= 0 && p < N) { pos = p; panX = 0; camera(); prevBtn.disabled = false; return; }
    }
    if (i + d < 0 || i + d >= SLIDES.length) return;
    show(i + d, d);
  }

  function setLook(l: string) {
    look = l; root!.dataset.look = l;
    try { localStorage.setItem('lof-look', l); } catch (_) {}
    root!.querySelectorAll<HTMLButtonElement>('.lof-look').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.look === l)));
    const sl = SLIDES[i];
    if (sl.type === 'card') stage.querySelectorAll<HTMLImageElement>('img.push').forEach(img => { img.src = still(sl.image); });
  }

  // the stage's scale follows the column
  const fit = () => { stage.style.transform = `scale(${screen.clientWidth / 1920})`; };
  new ResizeObserver(fit).observe(screen); fit();

  prevBtn.addEventListener('click', () => step(-1));
  nextBtn.addEventListener('click', () => step(1));
  root.querySelectorAll<HTMLButtonElement>('.lof-look').forEach(b => b.addEventListener('click', () => setLook(b.dataset.look!)));
  root.addEventListener('keydown', e => {
    if (e.target instanceof HTMLButtonElement && (e.key === ' ' || e.key === 'Enter')) return;
    if (['ArrowRight', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); step(1); }
    else if (['ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); step(-1); }
  });

  // a click on the stage steps on (the left third steps back); on the timeline a drag pans it, and it settles on the event at the centre
  let down: { x: number; pan: number; moved: boolean } | null = null;
  screen.addEventListener('pointerdown', e => { down = { x: e.clientX, pan: panX, moved: false }; });
  screen.addEventListener('pointermove', e => {
    if (!down || SLIDES[i].type !== 'timeline') return;
    const k = screen.clientWidth / 1920, dx = (e.clientX - down.x) / k;
    if (!down.moved && Math.abs(dx) < 12) return;
    if (!down.moved) { down.moved = true; screen.setPointerCapture(e.pointerId); }
    panX = Math.max(-(N - 1 - pos) * SP * Z - SP * Z / 2, Math.min(pos * SP * Z + SP * Z / 2, down.pan + dx)); camera(true);
  });
  const settle = () => {
    const kc = Math.max(0, Math.min(N - 1, Math.round(pos - panX / (SP * Z))));
    pos = kc; panX = 0; camera(); prevBtn.disabled = i === 0 && pos === 0;
  };
  screen.addEventListener('pointerup', e => {
    if (!down) return; const d = down; down = null;
    if (d.moved) { settle(); return; }
    const r = screen.getBoundingClientRect();
    step(e.clientX - r.left < r.width / 3 ? -1 : 1);
  });
  screen.addEventListener('pointercancel', () => { if (down?.moved) settle(); down = null; });
  let wheelT: number | undefined;
  screen.addEventListener('wheel', e => {
    if (SLIDES[i].type !== 'timeline' || Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
    e.preventDefault(); panX -= e.deltaX / (screen.clientWidth / 1920); camera(true);
    clearTimeout(wheelT); wheelT = window.setTimeout(settle, 180);
  }, { passive: false });

  setLook(look);
  show(0);
}
</script>

<script>
// The P(DOOM) plate: OpenSeadragon over the plate's deep-zoom tiles on R2, loaded when the plate comes near the screen. Each stop is a
// box in fractions of the plate's 12288 x 8192 canvas: the plate studio's shots, a few closer ones, and four of the town's small scenes.
const pd = document.querySelector<HTMLElement>('[data-lof-plate]');
if (pd) {
  const TILES = 'https://pub-066596d7e4fe4de2b74eac13bb03fe55.r2.dev/line-of-flight/p-doom-plate/v1/plate_files/';
  type Box = [number, number, number, number];
  const STOPS: [string, string, Box][] = [
    ['The whole plate', 'The town from above, with a cave under its street and eight small scenes hidden in it.', [0, 0, 1, 1]],
    ['The forum', 'The AI is chained to the old well, and the town holds up blank tablets to it.', [0.3316, 0.2925, 0.359, 0.3525]],
    ['The well', 'Grimes sits chained at the AI’s side, Princess Leia to its Jabba.', [0.47, 0.405, 0.078, 0.092]],
    ['The emperor’s balcony', 'Trump presides as emperor with Vance, Thiel, Musk, Amodei, Altman and Huang. Below, Ramaswamy, Sanders and Ocasio-Cortez speak to the crowd.', [0.444, 0.199, 0.116, 0.105]],
    ['The town hall’s protest', 'A protest pours off the town hall steps toward the city stair.', [0.28, 0.3, 0.2, 0.11]],
    ['The city stair', 'Young protesters from the city march up to the data centre.', [0.1948, 0.1753, 0.1897, 0.2939]],
    ['The data centre', 'A tower of Babel, with country folk shouting up from one side and the city’s young from the other.', [0.1297, 0, 0.2158, 0.2646]],
    ['The country road', 'Country folk march in with pitchforks and placards, and Xi Jinping hands them pamphlets.', [0, 0.42, 0.16, 0.16]],
    ['The temple', 'Its followers climb the cliff with glowing tablets, and one goes over the edge.', [0.618, 0.13, 0.166, 0.16]],
    ['The Vatican', 'Pope Leo XIV receives Chris Olah, kneeling, at the church door.', [0.865, 0.18, 0.075, 0.14]],
    ['The dinner', 'Chris Olah and Rabbi Mois Navon sit at a candlelit table that has gone quiet.', [0.885, 0.345, 0.1, 0.06]],
    ['The circles', 'Scholars of many faiths sit in a circle before a screen of scribble.', [0.83, 0.53, 0.066, 0.058]],
    ['The barricade', 'Yudkowsky rides his cart, carried by the Terminator and HAL, beside Bankman-Fried and Ellison in a cage.', [0.443, 0.588, 0.1, 0.05]],
    ['The charge', 'Beff Jezos leads the accelerationists on his barrel, with Nick Land at the back holding his lantern.', [0.47, 0.643, 0.046, 0.095]],
    ['The rationalists’ party', 'Aella hosts Dawkins, Dennett, Hitchens and Sam Harris, and Hitchens has lost his trousers.', [0.645, 0.695, 0.062, 0.054]],
    ['The cave', 'Under the street, chained watchers face the AI’s shadow on the wall.', [0.41, 0.865, 0.16, 0.08]],
    ['The proposal', 'A man proposes to his tablet while his partner waits with their toddler.', [0.15404, 0.51373, 0.02616, 0.03369]],
    ['The funeral', 'Mourners carry a tablet on a bier.', [0.03877, 0.67342, 0.03703, 0.03723]],
    ['The fountain', 'Townsfolk sweep a tablet away from the fountain while a man beside them eats a whole roast.', [0.36036, 0.83078, 0.04362, 0.04022]],
    ['The paper crown', 'A wife and son drag a man in a paper crown of stars away from his doorway.', [0.72205, 0.83603, 0.02987, 0.03461]],
  ];
  const R = 8192 / 12288;
  const view = pd.querySelector<HTMLElement>('.lof-pd-view')!, still = pd.querySelector<HTMLImageElement>('.lof-pd-still')!;
  const $ = (k: string) => pd.querySelector<HTMLElement>(`[data-pd="${k}"]`)!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let OSD: any = null, viewer: any = null, at = 0, open = false, moved = false;
  // the hint on the plate says what to do, in touch words on a phone, and fades once the plate is used
  if (matchMedia('(pointer: coarse)').matches) $('hint').textContent = 'Drag to look around. Pinch to zoom. Tap → for the next of its 20 scenes.';
  const used = () => pd!.classList.add('is-used');

  const inside = (x: number, y: number, [bx, by, bw, bh]: Box) => x >= bx && x <= bx + bw && y >= by * R && y <= (by + bh) * R;
  // a stop's box in the viewer's coordinates (the plate is 1 wide), with a little air round the close ones;
  // in a frame taller than the plate (a phone) the whole plate fills the frame's height, centred, and drags sideways
  function rect([x, y, w, h]: Box) {
    if (w >= 1) {
      const c = viewer.viewport.getContainerSize(), fw = R * c.x / c.y;
      return fw < 1 ? new OSD.Rect((1 - fw) / 2, 0, fw, R) : new OSD.Rect(0, 0, 1, R);
    }
    const p = Math.min(w, h * R) * 0.04;
    return new OSD.Rect(x - p, y * R - p, w + 2 * p, h * R + 2 * p);
  }
  function label() {
    const [name, text] = STOPS[at];
    $('n').textContent = String(at + 1); $('total').textContent = String(STOPS.length); $('name').textContent = name; $('text').textContent = text;
  }
  function go(i: number, instant = false) {
    at = (i + STOPS.length) % STOPS.length; moved = false; label();
    if (viewer) viewer.viewport.fitBoundsWithConstraints(rect(STOPS[at][2]), instant || reduce.matches);
  }
  function setOpen(v: boolean) {
    open = v;
    pd!.classList.toggle('is-open', v);
    document.documentElement.classList.toggle('lof-pd-lock', v);
    $('open').setAttribute('aria-pressed', String(v)); $('open').textContent = v ? 'Close' : 'Full screen';
    touch();
    view.focus({ preventScroll: true });
  }
  // in the page, a vertical swipe scrolls the page; full screen hands every gesture to the plate
  function touch() { if (viewer) for (const el of [viewer.container, viewer.canvas]) el.style.touchAction = open ? 'none' : 'pan-y'; }

  async function start() {
    OSD = (await import('openseadragon')).default;
    viewer = OSD({
      element: view, drawer: 'canvas', crossOriginPolicy: false, showNavigationControl: false,
      tileSources: { Image: { xmlns: 'http://schemas.microsoft.com/deepzoom/2008', Url: TILES, Format: 'webp', Overlap: '1', TileSize: '512', Size: { Width: '16384', Height: '10923' } } },
      animationTime: 0.9, visibilityRatio: 1, constrainDuringPan: true, minZoomImageRatio: 1, maxZoomPixelRatio: 2,
      gestureSettingsMouse: { clickToZoom: false }, gestureSettingsTouch: { clickToZoom: false }, gestureSettingsPen: { clickToZoom: false },
    });
    touch();
    viewer.addHandler('open', () => {
      go(at, true);
      viewer.world.getItemAt(0).addHandler('fully-loaded-change', (e: any) => { if (e.fullyLoaded) still.hidden = true; });
    });
    // in the page the wheel scrolls the page; Ctrl or Cmd with the wheel (and a trackpad pinch) zooms
    viewer.addHandler('canvas-scroll', (e: any) => {
      if (!open && !(e.originalEvent.ctrlKey || e.originalEvent.metaKey)) { e.preventDefaultAction = true; e.preventDefault = false; }
    });
    for (const ev of ['canvas-drag', 'canvas-scroll', 'canvas-pinch']) viewer.addHandler(ev, (e: any) => { if (!e.preventDefaultAction) { moved = true; used(); } });
    // a click on a scene flies to it: the smallest stop under the pointer, never out of the one we're in
    viewer.addHandler('canvas-click', (e: any) => {
      if (!e.quick) return;
      const p = viewer.viewport.pointFromPixel(e.position);
      if (at && inside(p.x, p.y, STOPS[at][2])) return;
      let best = -1;
      STOPS.forEach(([, , b], i) => { if (i && inside(p.x, p.y, b) && (best < 0 || b[2] * b[3] < STOPS[best][2][2] * STOPS[best][2][3])) best = i; });
      if (best > 0) { go(best); used(); }
    });
    // a new size (full screen, a turned phone) frames the stop again unless you've moved away from it
    viewer.addHandler('after-resize', () => requestAnimationFrame(() => { if (!moved) viewer.viewport.fitBoundsWithConstraints(rect(STOPS[at][2]), true); }));
  }

  $('prev').addEventListener('click', () => { go(at - 1); used(); });
  $('next').addEventListener('click', () => { go(at + 1); used(); });
  $('whole').addEventListener('click', () => { go(0); used(); });
  $('open').addEventListener('click', () => setOpen(!open));
  pd.addEventListener('keydown', e => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.target instanceof HTMLButtonElement && (e.key === ' ' || e.key === 'Enter')) return;
    if (e.key === 'ArrowRight' || e.key === 'PageDown') go(at + 1);
    else if (e.key === 'ArrowLeft' || e.key === 'PageUp') go(at - 1);
    else return;
    used();
    e.preventDefault(); e.stopPropagation();
  }, true);
  document.addEventListener('keydown', e => { if (open && e.key === 'Escape') setOpen(false); });

  label();
  const io = new IntersectionObserver(es => { if (es.some(e => e.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '600px 0px' });
  io.observe(pd);
}
</script>
